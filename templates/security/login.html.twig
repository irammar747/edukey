{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión - EduKey{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div class="container-fluid bg-light">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-5 col-lg-4 col-xl-3">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <div class="mb-2">
                                <img src="{{ asset('images/logo.png') }}"
                                     alt="EduKey Logo"
                                     style="width: 220px; height: auto; object-fit: contain;"
                                     class="img-fluid mx-auto">
                            </div>
                        </div>

                        <form method="post">
                            {% if error %}
                                <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center">
                                    <i data-lucide="alert-circle" class="me-2" style="width: 18px;"></i>
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            {% if app.user %}
                                <div class="mb-3 text-center">
                                    Estás identificado como <strong>{{ app.user.userIdentifier }}</strong>,
                                    <a href="{{ path('app_logout') }}" class="text-danger">Cerrar Sesión</a>
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                <label for="inputUsername" class="form-label fw-semibold">Nombre de usuario</label>
                                <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i data-lucide="user" style="width: 18px;"></i>
                                </span>
                                    <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control border-start-0 bg-light" autocomplete="username" required autofocus placeholder="Ej: usuario1">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="inputPassword" class="form-label fw-semibold">Contraseña</label>
                                <div class="input-group flex-nowrap">
                                <span class="input-group-text bg-light border-end-0">
                                    <i data-lucide="key-round" style="width: 18px;"></i>
                                </span>
                                    <input type="password" name="password" id="inputPassword" class="form-control border-start-0 bg-light" autocomplete="current-password" required>

                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                                    <label class="form-check-label text-muted" for="_remember_me">Recordarme</label>
                                </div>
                                <div>
                                    <a href="#" class="text-decoration-none small fw-semibold text-primary">
                                        ¿Has olvidado tu contraseña?
                                    </a>
                                </div>
                            </div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="mb-4 form-check">
                                <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                                <label class="form-check-label text-muted" for="_remember_me">Recordarme en este equipo</label>
                            </div>

                            <button class="btn btn-dark w-100 py-2 fw-bold d-flex align-items-center justify-content-center" type="submit">
                                <i data-lucide="log-in" class="me-2" style="width: 20px;"></i>
                                Entrar al sistema
                            </button>
                        </form>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <small class="text-muted">&copy; {{ "now"|date("Y") }} EduKey - Gestión de Recursos</small>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
