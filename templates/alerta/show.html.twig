{% extends 'base.html.twig' %}

{% block title %}Alerta{% endblock %}

{% block body %}
    <h1>Alerta</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ alertum.id }}</td>
            </tr>
            <tr>
                <th>Fecha</th>
                <td>{{ alertum.fecha ? alertum.fecha|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Estado</th>
                <td>{{ alertum.estado }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_alerta_index') }}">back to list</a>

    <a href="{{ path('app_alerta_edit', {'id': alertum.id}) }}">edit</a>

    {{ include('alerta/_delete_form.html.twig') }}
{% endblock %}
