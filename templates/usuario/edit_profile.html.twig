{% extends 'base.html.twig' %}

{% block title %}Editar Mi Perfil{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow border-0">
                    <div class="card-header bg-dark text-white p-3">
                        <h5 class="mb-0"><i data-lucide="settings" class="me-2"></i>Actualizar Mis Datos</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-info py-2 small">
                            <i data-lucide="info" class="me-1" style="width: 14px;"></i>
                            Por motivos de seguridad, el nombre de usuario, el departamento o los roles asignados no se pueden modificar. Si necesita realizar alguna modificación, por favor, contacte con el administrador del sistema.
                        </div>

                        {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary btn-lg">Guardar Cambios</button>
                            <a href="{{ path('app_perfil') }}" class="btn btn-light text-muted">Cancelar</a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
