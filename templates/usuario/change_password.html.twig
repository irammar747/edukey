{% extends 'base.html.twig' %}

{% block title %}Cambiar Contraseña - EduKey{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow border-0">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 text-center">Cambiar Contraseña</h4>

                        {# 1. Iniciamos el formulario de Symfony #}
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo':'false'}}) }}
                        <div class="mb-3">
                            <label class="form-label fw-bold w-100">
                                Nueva Contraseña
                                {{ form_widget(form.plainPassword.first, {
                                    'attr': {
                                        'class': 'form-control form-control-lg ' ~ (form.plainPassword.first.vars.errors|length > 0 ? 'is-invalid' : ''),
                                        'placeholder': 'Mínimo 6 caracteres'
                                    }
                                }) }}
                            </label>
                            {# El error debe estar AQUÍ, fuera del label #}
                            {% if form.plainPassword.first.vars.errors|length > 0 %}
                                <div class="text-danger small mt-1 d-block">
                                    {% for error in form.plainPassword.first.vars.errors %}
                                        {{ error.messageTemplate|replace({'{{ limit }}': '6'}) }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {# 4. Usamos el objeto form para la repetición #}
                            <label class="form-label fw-bold w-100">
                                Confirmar Nueva Contraseña
                                {{ form_widget(form.plainPassword.second, {
                                    'attr': {'class': 'form-control form-control-lg'}
                                }) }}
                            </label>
                            {# 5. Pintamos el error si no coinciden aquí #}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.plainPassword.second) }}
                                {{ form_errors(form.plainPassword) }}
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">Actualizar Contraseña</button>
                        </div>

                        {# 6. Cerramos el formulario de Symfony #}
                        {{ form_end(form) }}

                        <div class="text-center mt-3">
                            <a href="{{ path('app_perfil') }}" class="text-muted small">Cancelar y volver</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
