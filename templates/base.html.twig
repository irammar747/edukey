<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Bienvenido!{% endblock %}</title>
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">

    {# Fuentes e Iconos Externos #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {% block stylesheets %}

    {% endblock %}

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body>
{% block header %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
                <i data-lucide="graduation-cap" class="me-2"></i> EduKey
            </a>
            <!-- Botón de hamburguesa -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" href="{{ path('app_departamento_index') }}">
                            <i data-lucide="building-2" class="me-1" style="width: 18px;"></i> Departamentos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" href="{{ path('app_usuario_index') }}">
                            <i data-lucide="users" class="me-1" style="width: 18px;"></i> Usuarios
                        </a>
                    </li>
                </ul>
                <!-- Botones de Usuario y cerrar sesión -->
                <ul class="navbar-nav ms-auto align-items-center">
                    {% if app.user %}
                        <li class="nav-item me-lg-3">
                            <a class="nav-link d-flex align-items-center" href="{{ path('app_perfil') }}">
                                <i data-lucide="user" class="me-1" style="width: 18px;"></i>
                                Mi Perfil
                            </a>
                        </li>

                        <li class="nav-item mt-2 mt-lg-0">
                            <a class="nav-link d-flex align-items-center text-danger" href="{{ path('app_logout') }}">
                                <i data-lucide="log-out" class="me-1" style="width: 18px;"></i>
                                Cerrar Sesión
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
{% endblock %}
{% block body %}{% endblock %}

{# SCRIPTS DE TERCEROS #}
<script src="https://unpkg.com/lucide@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("turbo:load", function () {
        // 1. Inicializamos los iconos de Lucide cada vez que cambia la página
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // 2. Mensajes flash reactivos a Turbo
        {% for label, messages in app.flashes %}
        {% for message in messages %}
        Swal.fire({
            icon: '{{ label == "danger" ? "error" : (label == "warning" ? "warning" : "success") }}',
            title: '{{ label|capitalize }}',
            text: '{{ message }}',
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true
        });
        {% endfor %}
        {% endfor %}
    });

    document.addEventListener("turbo:load", function () {
        // Buscamos inputs de password que no hayan sido procesados aún
        // Usamos una clase de control para evitar duplicar el "ojo" si Turbo recarga
        const passwordFields = document.querySelectorAll('input[type="password"]:not(.processed-pwd)');

        passwordFields.forEach(field => {
            field.classList.add('processed-pwd'); // Marcamos como procesado

            // Contenedor para el posicionamiento
            const wrapper = document.createElement('div');
            // flex-grow-1 para que no salte de línea dentro del input-group
            wrapper.className = 'position-relative flex-grow-1';
            field.parentNode.insertBefore(wrapper, field);
            wrapper.appendChild(field);

            // Botón del ojo
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted text-decoration-none pe-3';
            btn.innerHTML = '<i data-lucide="eye" style="width: 18px; height: 18px;"></i>';
            btn.style.zIndex = '5';
            btn.style.boxShadow = 'none'; // Evitar sombra de botón al hacer clic

            wrapper.appendChild(btn);

            // Actualizamos solo este nuevo icono de Lucide
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Evento para conmutar
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const isPassword = field.type === 'password';
                field.type = isPassword ? 'text' : 'password';

                // Cambiamos el icono según el estado
                btn.innerHTML = isPassword
                    ? '<i data-lucide="eye-off" style="width: 18px; height: 18px;"></i>'
                    : '<i data-lucide="eye" style="width: 18px; height: 18px;"></i>';

                lucide.createIcons();
                field.focus(); // Devolvemos el foco al input
            });
        });
    });
</script>
</body>
</html>
