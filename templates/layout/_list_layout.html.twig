{# templates/layout/_list_layout.html.twig #}

<link href="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3/dist/style.css" rel="stylesheet" type="text/css">

<style>
    /* 1. CABECERA NEGRA Y FLECHAS */

    #tabla-interactiva thead th {
        background-color: #212529 !important;
        color: white !important;
        padding-right: 35px !important;
        border-right: 2px solid rgba(255, 255, 255, 0.5) !important; /* Línea de separación */
        position: relative;
        text-align: center;
    }
    .datatable-sorter::before, .datatable-sorter::after {
        filter: brightness(0) invert(1) contrast(2) !important;

        border-top-width: 5px !important;
        border-bottom-width: 5px !important;
    }
    button.datatable-sorter{
        padding-right: 35px !important;
    }
    .datatable-dropdown label {
        font-size: 14px !important;
        color: #6c757d;
    }

    /* Al pasar el ratón sobre el botón, el icono se vuelve blanco */
    .btn-action-custom:hover .icon{
        stroke: white !important;
    }

    /* Suavizamos la transición del color */
    .icon {
        transition: stroke 0.1s ease-in-out;
        width: 18px;
    }
    /* Centrado vertical para todas las celdas de la tabla */
    .table tbody td:not(:first-child),
    .table thead th:not(:first-child) {
        vertical-align: middle !important;

    }

    /* Ajuste específico para la columna de acciones (iconos) */
    .d-flex.justify-content-center.gap-2 {
        align-items: center !important; /* Centra los iconos entre sí */
    }

    /* Ajuste para la columna de Usuario/Email */
    td .fw-bold.text-dark,
    td .text-muted.small {
        line-height: 1.2; /* Evita que el interlineado empuje el contenido hacia abajo */
    }
    @media (max-width: 767px) {
        /* Quitamos el padding excesivo del contenedor de la tabla */
        .table-responsive.p-3 {
            padding: 0.5rem !important;
        }

        /* Reducimos el padding de las celdas de la tabla */
        #tabla-interactiva th,
        #tabla-interactiva td {
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
        }

        /* Ajuste para que la primera celda (Código) no tenga tanto margen */
        .ps-4 {
            padding-left: 0.75rem !important;
        }
    }
</style>

<div class="container-fluid px-2 px-md-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h1 class="fw-extrabold text-dark mb-0" style="letter-spacing: -1px;">
                {% block titulo %}{% endblock %}
            </h1>
            <p class="text-muted small mb-0">{% block subtitulo %}{% endblock %}</p>
        </div>

        <a href="{% block ruta_nuevo %}{% endblock %}" class="btn btn-primary shadow-sm d-flex align-items-center px-4 py-2">
            <i data-lucide="plus-circle" class="me-2" style="width: 20px;"></i>
            Crear nuevo
        </a>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden rounded-0 rounded-md-4">
        <div class="table-responsive p-0 p-md-3"> {# p-0 en móvil para ganar espacio #}
            <table class="table table-hover align-middle mb-0" id="tabla-interactiva">
                <thead class="cabecera-personalizada">
                <tr>
                    {% block tabla_cabecera %}{% endblock %}
                    <th class="text-center" data-sortable="false">ACCIONES</th>
                </tr>
                </thead>
                <tbody>
                    {% block tabla_cuerpo %}{% endblock %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Scripts al final #}


<script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3/dist/umd/simple-datatables.js" type="text/javascript"></script>

<script>
    // 1. Registro global de las funciones para que Turbo no las pierda
    window.confirmDelete = function(id, text = "Este registro se eliminará permanentemente.", numRelaciones = 0) {
        let titulo = '¿Estás seguro?';
        let texto = text;
        let icono = 'warning';

        // Si detectamos que hay elementos que dependen de este por FK relacionadas
        if (numRelaciones > 0) {
            titulo = '¡Atención: Registros vinculados!';
            texto = `Existen ${numRelaciones} préstamos asociados. Si continúas, se borrará TODO el historial relacionado permanentemente.`;
            icono = 'error';
        }

        Swal.fire({
            title: titulo,
            text: texto,
            icon: icono,
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6e7881',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.getElementById('delete-form-' + id);
                if (form) form.submit();
            }
        });
    };

    window.confirmResetPassword = function(id, email) {
        // 1. Limpieza de residuos visuales
        document.querySelectorAll('.tooltip').forEach(t => t.remove());

        Swal.fire({
            title: '¿Enviar acceso?',
            text: "Se enviará un enlace de recuperación a " + email,
            icon: 'question',
            iconColor: '#ffc107',
            showCancelButton: true,
            confirmButtonColor: '#ffc107',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, enviar email',
            cancelButtonText: 'Cancelar',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                // Buscamos el formulario de forma específica
                const form = document.getElementById('reset-pass-form-' + id);

                if (form) {
                    console.log("Formulario encontrado, enviando...");

                    // Mostramos el estado de carga
                    Swal.fire({
                        title: 'Enviando...',
                        text: 'Por favor, espere un momento.',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Enviamos el formulario manualmente
                    form.submit();
                } else {
                    console.error("ERROR: No se encontró el formulario con ID: reset-pass-form-" + id);
                    Swal.fire('Error', 'No se pudo localizar el formulario de envío.', 'error');
                }
            }
        });
    };

    // 2. Inicialización de Tabla e Iconos compatible con Turbo
    document.addEventListener("turbo:load", function() {

        const table = document.querySelector("#tabla-interactiva");

        if (table) {

            // Para evitar inicializar dos veces
            if (table.classList.contains('dataTable-table')) return;

            const dataTable = new simpleDatatables.DataTable(table, {
                searchable: true,
                fixedHeight: false,
                labels: {
                    placeholder: "Buscar...",
                    perPage: "registros por página",
                    noRows: "No se encontraron registros",
                    info: "Mostrando {start} a {end} de {rows} registros",
                }
            });

            const refreshIcons = () => {
                requestAnimationFrame(() => {
                    if (typeof lucide !== 'undefined') {
                        lucide.createIcons();
                    }
                });
            };

            // Refrescar al iniciar, al cambiar de página o al buscar
            dataTable.on("datatable.init", refreshIcons);
            dataTable.on("datatable.page", refreshIcons);
            dataTable.on("datatable.search", refreshIcons);
            dataTable.on("datatable.sort", refreshIcons);
            dataTable.on("datatable.perpage", refreshIcons);
            dataTable.on("datatable.update", refreshIcons);
        }

        // Refrescar iconos general por si acaso
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
