{# templates/departamento/_delete_form.html.twig #}

{# 1. Le ponemos un ID al formulario para poder identificarlo desde JS #}
<form id="delete-form-{{ departamento.id }}" method="post" action="{{ path('app_departamento_delete', {'id': departamento.id}) }}" data-turbo="false"
      style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ departamento.id) }}">

    {# 2. Cambiamos type="submit" por type="button" y añadimos el onclick #}
    <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center shadow-sm"
            onclick="confirmDelete({{ departamento.id }})">
        <i data-lucide="trash-2" class="me-1" style="width: 16px;"></i>
        Eliminar Departamento
    </button>
</form>


