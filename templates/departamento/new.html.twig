{# templates/departamento/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nuevo Departamento - EduKey{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item">
        <a href="{{ path('app_departamento_index') }}" class="text-decoration-none d-flex align-items-center text-muted small fw-bold">
            Departamentos
        </a>
    </li>
    <li class="breadcrumb-item active small text-muted fw-bold">Nuevo Departamento</li>
{% endblock %}

{% block body %}
    {% embed 'layout/_form_layout.html.twig' %}
    {% block form_icon %}building-2{% endblock %}

    {% block form_title %}Crear Nuevo Departamento{% endblock %}

    {% block ruta_volver %}{{ path('app_departamento_index') }}{% endblock %}

        {% block form_content %}
            {{ include('departamento/_form.html.twig', { 'is_edit': false }) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
