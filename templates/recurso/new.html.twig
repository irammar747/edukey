{% extends 'base.html.twig' %}

{% block title %}Nuevo Recurso - EduKey{% endblock %}
{% block breadcrumb_items %}
    <li class="breadcrumb-item">
        <a href="{{ path('app_recurso_index') }}" class="text-decoration-none text-muted small fw-bold">Recursos</a>
    </li>
    <li class="breadcrumb-item active small text-muted fw-bold">Nuevo</li>
{% endblock %}
{% block body %}
    {% embed 'layout/_form_layout.html.twig' %}
        {% block form_icon %}user-plus{% endblock %}
        {% block form_title %}Crear Nuevo Recurso{% endblock %}
        {% block ruta_volver %}{{ path('app_recurso_index') }}{% endblock %}

        {% block form_content %}
            <p class="text-muted small mb-4">Completa los datos del recurso para darle acceso al sistema.</p>

            {# Renderizamos el formulario #}
            {{ form_widget(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
