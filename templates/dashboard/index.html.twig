{# templates/dashboard/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Panel de Control - EduKey{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="text-center mb-5">
            <h1 class="fw-bold">Bienvenido, {{ app.user.nombre }}</h1>
            <p class="text-muted">¿Qué deseas gestionar hoy?</p>
        </div>

        <div class="row g-4 justify-content-center">

            {# TARJETA: GESTIÓN DE USUARIOS (Solo Admin) #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="col-md-4 col-lg-3">
                    <a href="{{ path('app_usuario_index') }}" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 hover-card text-center p-4">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-block mx-auto mb-3">
                                <i data-lucide="users" class="text-success" style="width: 40px; height: 40px;"></i>
                            </div>
                            <h5 class="text-success-emphasis fw-bold">Usuarios</h5>
                            <p class="text-muted small">Administra cuentas, roles y accesos.</p>
                        </div>
                    </a>
                </div>
            {% endif %}

            {# TARJETA: DEPARTAMENTOS (Admin y Personal) #}
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PERSONAL') %}
                <div class="col-md-4 col-lg-3">
                    <a href="{{ path('app_departamento_index') }}" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 hover-card text-center p-4">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-3 d-inline-block mx-auto mb-3">
                                <i data-lucide="building-2" class="text-warning" style="width: 40px; height: 40px;"></i>
                            </div>
                            <h5 class="text-warning-emphasis fw-bold">Departamentos</h5>
                            <p class="text-muted small">Organiza las áreas y personal del centro.</p>
                        </div>
                    </a>
                </div>
            {% endif %}
            {# TARJETA: RECURSOS (Admin y Personal) #}
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PERSONAL') %}
                <div class="col-md-4 col-lg-3">
                    <a href="{{ path('app_recurso_index') }}" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 hover-card text-center p-4">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-block mx-auto mb-3">
                                <i data-lucide="door-open" class="text-info" style="width: 40px; height: 40px;"></i>
                            </div>
                            <h5 class="text-info-emphasis fw-bold">Recursos</h5>
                            <p class="text-muted small">Organiza las aulas y laboratorios del centro.</p>
                        </div>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .hover-card {
            transition: transform 0.2s, shadow 0.2s;
        }
        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            border: 1px solid rgba(13, 110, 253, 0.2) !important;
        }
    </style>
{% endblock %}
